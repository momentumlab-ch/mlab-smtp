#, php-format
msgid "Testmail von %s"
msgstr "E-mail di prova da %s"

#: inc/check.php:126
msgid "Diese Nachricht bestätigt, dass der E-Mail-Versand funktioniert."
msgstr "Questo messaggio conferma che l'invio di e-mail funziona."

