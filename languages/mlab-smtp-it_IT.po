#. Plugin Name of the plugin
#: mlab-smtp.php:3
msgid "MomentumLab SMTP"
msgstr "MomentumLab SMTP"

#. Description of the plugin
#: mlab-smtp.php:4
msgid "Versendet WordPress-E-Mails über einen eigenen Mailserver (SMTP), Microsoft 365, Google oder Resend."
msgstr "Invia le e-mail di WordPress tramite un proprio server di posta (SMTP), Microsoft 365, Google o Resend."

#. Author of the plugin
#: mlab-smtp.php:8
msgid "MomentumLab"
msgstr "MomentumLab"

#. Author URI of the plugin
#: mlab-smtp.php:9
msgid "https://momentumlab.ch"
msgstr "https://momentumlab.ch"

#: inc/admin/components.php:31
msgid "Microsoft 365"
msgstr "Microsoft 365"

#: inc/admin/components.php:35
msgid "Für Firmen mit Microsoft 365 oder Outlook. Kein Passwort auf der Website."
msgstr "Per aziende con Microsoft 365 o Outlook. Nessuna password sul sito."

#: inc/admin/components.php:36
msgid "Kein Passwort auf der Website"
msgstr "Nessuna password sul sito"

#: inc/admin/components.php:36
msgid "Einmalig App in Microsoft anlegen"
msgstr "Una tantum: crei un'app in Microsoft"

#: inc/admin/components.php:39
msgid "Verbunden. Microsoft hat die Zugangsdaten akzeptiert."
msgstr "Collegato. Microsoft ha accettato le credenziali."

#: inc/admin/components.php:43
msgid "Google Workspace"
msgstr "Google Workspace"

#: inc/admin/components.php:47
msgid "Für Firmen mit Google Workspace oder Gmail. Anmeldung mit dem Google-Konto."
msgstr "Per aziende con Google Workspace o Gmail. Accesso con l'account Google."

#: inc/admin/components.php:48
msgid "Anmelden mit Google-Konto"
msgstr "Accedere con account Google"

#: inc/admin/components.php:48
msgid "Einmalig Zugang in Google Cloud anlegen"
msgstr "Una tantum: crei l'accesso in Google Cloud"

#: inc/admin/components.php:51
msgid "Verbunden. Google hat den Zugriff bestätigt."
msgstr "Collegato. Google ha confermato l'accesso."

#: inc/admin/components.php:56
msgid "Das verbundene Google-Konto. Google erlaubt nur dieses oder einen freigegebenen Alias."
msgstr "L'account Google collegato. Google consente solo questo o un alias condiviso."

#: inc/admin/components.php:57
msgid "Vorgegeben durch das verbundene Google-Konto."
msgstr "Impostato dall'account Google collegato."

#: inc/admin/components.php:62
msgid "Resend"
msgstr "Resend"

#: inc/admin/components.php:66
msgid "Versanddienst für Website-Mails, braucht kein Postfach. Nur ein API-Key nötig."
msgstr "Servizio di invio per le e-mail del sito, non richiede una casella di posta. Serve solo una chiave API."

#: inc/admin/components.php:67
msgid "Nur ein API-Key, keine Anmeldung"
msgstr "Solo una chiave API, nessun accesso"

#: inc/admin/components.php:67
msgid "Prüft Ihre Domain und zeigt fehlende DNS-Einträge"
msgstr "Controlla il dominio e mostra le voci DNS mancanti"

#: inc/admin/components.php:71
msgid "Ersatzweg erreichbar. Resend hat den API-Key akzeptiert."
msgstr "Via di riserva raggiungibile. Resend ha accettato la chiave API."

#: inc/admin/components.php:74
msgid "Die Domain muss bei Resend verifiziert sein. Das Postfach muss nicht existieren, zum Beispiel noreply@ihre-domain.ch."
msgstr "Il dominio deve essere verificato presso Resend. La casella di posta non deve esistere, ad esempio noreply@il-suo-dominio.ch."

#: inc/admin/components.php:81
msgid "Eigener Mailserver"
msgstr "Server di posta proprio"

#: inc/admin/components.php:85
msgid "Für den Mailserver Ihres Hosters, z. B. Infomaniak, Hostpoint, cyon."
msgstr "Per il server di posta del proprio hoster, ad es. Infomaniak, Hostpoint, cyon."

#: inc/admin/components.php:86
msgid "Server, Benutzer und Passwort"
msgstr "Server, utente e password"

#: inc/admin/components.php:86
msgid "Funktioniert mit fast jedem Anbieter"
msgstr "Funziona con quasi tutti i provider"

#: inc/admin/components.php:89
msgid "Die Anmeldung am Server war erfolgreich."
msgstr "L'accesso al server è riuscito."

#: inc/admin/components.php:90
msgid "Ersatzweg erreichbar. Die Anmeldung am Server war erfolgreich."
msgstr "Via di riserva raggiungibile. L'accesso al server è riuscito."

#: inc/admin/components.php:227
msgid "Wartet auf Versand"
msgstr "In attesa di invio"

#: inc/admin/components.php:227
msgid "Die Mail liegt in der Warteschlange und wird gleich gesendet."
msgstr "L'e-mail è in coda e verrà inviata a breve."

#: inc/admin/components.php:228
msgid "Wird gesendet"
msgstr "In invio"

#: inc/admin/components.php:228
msgid "Die Mail wird gerade an den Anbieter übergeben."
msgstr "L'e-mail viene ora consegnata al provider."

#: inc/admin/components.php:229
#: inc/admin/log-view.php:18
msgid "Vom Anbieter angenommen"
msgstr "Accettata dal provider"

#: inc/admin/components.php:229
msgid "Der Anbieter hat die Mail übernommen. Ob sie im Postfach ankam, bestätigt er erst mit einem Zustellbeleg."
msgstr "Il provider ha preso in carico l'e-mail. Se è arrivata nella casella di posta, lo confermerà solo con una ricevuta di consegna."

#: inc/admin/components.php:230
#: inc/admin/log-view.php:19
#: inc/admin/log-view.php:197
msgid "Zustellung bestätigt"
msgstr "Consegna confermata"

#: inc/admin/components.php:230
msgid "Der Anbieter hat die Zustellung ins Postfach des Empfängers bestätigt."
msgstr "Il provider ha confermato la consegna nella casella di posta del destinatario."

#: inc/admin/components.php:231
msgid "Wird erneut versucht"
msgstr "Nuovo tentativo in corso"

#: inc/admin/components.php:231
msgid "Der letzte Versuch hat nicht geklappt. Das Plugin versucht es automatisch noch einmal."
msgstr "L'ultimo tentativo non è riuscito. Il plugin riprova automaticamente ancora una volta."

#: inc/admin/components.php:232
#: inc/admin/overview.php:317
#: inc/admin/queue-view.php:53
msgid "Endgültig fehlgeschlagen"
msgstr "Fallito definitivamente"

#: inc/admin/components.php:232
msgid "Die Mail wurde nicht gesendet und wird nicht mehr automatisch versucht."
msgstr "L'e-mail non è stata inviata e non verranno effettuati altri tentativi automatici."

#: inc/admin/components.php:233
#: inc/health.php:339
msgid "Versandstatus unklar"
msgstr "Stato di invio incerto"

#: inc/admin/components.php:233
msgid "Der Anbieter hat möglicherweise angenommen. Das Plugin sendet nicht von selbst erneut, damit nichts doppelt ankommt."
msgstr "Il provider potrebbe aver accettato l'e-mail. Il plugin non invia di nuovo da sé, per evitare duplicati."

#: inc/admin/components.php:234
msgid "Teilweise angenommen"
msgstr "Accettata in parte"

#: inc/admin/components.php:234
msgid "Einzelne Empfänger wurden abgelehnt, die übrigen wurden angenommen."
msgstr "Alcuni destinatari sono stati respinti, gli altri sono stati accettati."

#: inc/admin/components.php:235
msgid "Nicht gesendet (Staging-Schutz)"
msgstr "Non inviata (protezione staging)"

#: inc/admin/components.php:235
msgid "Der Staging-Schutz hat den Versand dieser Mail verhindert."
msgstr "La protezione staging ha impedito l'invio di questa e-mail."

#: inc/admin/components.php:236
#: inc/admin/log-view.php:199
msgid "Zurückgewiesen"
msgstr "Respinta"

#: inc/admin/components.php:236
msgid "Der Mailserver des Empfängers hat die Mail zurückgewiesen."
msgstr "Il server di posta del destinatario ha respinto l'e-mail."

#: inc/admin/components.php:237
#: inc/admin/log-view.php:200
msgid "Als Spam gemeldet"
msgstr "Segnalata come spam"

#: inc/admin/components.php:237
msgid "Der Empfänger hat die Mail als unerwünscht gemeldet."
msgstr "Il destinatario ha segnalato l'e-mail come indesiderata."

#: inc/admin/components.php:239
msgid "Status unbekannt"
msgstr "Stato sconosciuto"

