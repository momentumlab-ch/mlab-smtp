#. Plugin Name of the plugin
#: mlab-smtp.php:3
msgid "MomentumLab SMTP"
msgstr "MomentumLab SMTP"

#. Description of the plugin
#: mlab-smtp.php:4
msgid "Versendet WordPress-E-Mails über einen eigenen Mailserver (SMTP), Microsoft 365, Google oder Resend."
msgstr "Sends WordPress emails via your own mail server (SMTP), Microsoft 365, Google or Resend."

#. Author of the plugin
#: mlab-smtp.php:8
msgid "MomentumLab"
msgstr "MomentumLab"

#. Author URI of the plugin
#: mlab-smtp.php:9
msgid "https://momentumlab.ch"
msgstr "https://momentumlab.ch"

#: inc/admin/components.php:27
msgid "Microsoft 365"
msgstr "Microsoft 365"

#: inc/admin/components.php:31
msgid "Für Firmen mit Microsoft 365 oder Outlook. Kein Passwort auf der Website."
msgstr "For companies with Microsoft 365 or Outlook. No password on the website."

#: inc/admin/components.php:32
msgid "Kein Passwort auf der Website"
msgstr "No password on the website"

#: inc/admin/components.php:32
msgid "Einmalig App in Microsoft anlegen"
msgstr "One-time: create an app in Microsoft"

#: inc/admin/components.php:35
msgid "Verbunden. Microsoft hat die Zugangsdaten akzeptiert."
msgstr "Connected. Microsoft has accepted the credentials."

#: inc/admin/components.php:39
msgid "Google Workspace"
msgstr "Google Workspace"

#: inc/admin/components.php:43
msgid "Für Firmen mit Google Workspace oder Gmail. Anmeldung mit dem Google-Konto."
msgstr "For companies with Google Workspace or Gmail. Sign in with your Google account."

#: inc/admin/components.php:44
msgid "Anmelden mit Google-Konto"
msgstr "Sign in with Google account"

#: inc/admin/components.php:44
msgid "Einmalig Zugang in Google Cloud anlegen"
msgstr "One-time: create access in Google Cloud"

#: inc/admin/components.php:47
msgid "Verbunden. Google hat den Zugriff bestätigt."
msgstr "Connected. Google has confirmed access."

#: inc/admin/components.php:52
msgid "Das verbundene Google-Konto. Google erlaubt nur dieses oder einen freigegebenen Alias."
msgstr "The connected Google account. Google only allows this one or an approved alias."

#: inc/admin/components.php:53
msgid "Vorgegeben durch das verbundene Google-Konto."
msgstr "Set by the connected Google account."

#: inc/admin/components.php:58
msgid "Resend"
msgstr "Resend"

#: inc/admin/components.php:62
msgid "Versanddienst für Website-Mails, braucht kein Postfach. Nur ein API-Key nötig."
msgstr "Sending service for website emails; no mailbox needed. Only an API key is required."

#: inc/admin/components.php:63
msgid "Nur ein API-Key, keine Anmeldung"
msgstr "Only an API key, no sign-in"

#: inc/admin/components.php:63
msgid "Prüft Ihre Domain und zeigt fehlende DNS-Einträge"
msgstr "Checks your domain and shows missing DNS records"

#: inc/admin/components.php:67
msgid "Ersatzweg erreichbar. Resend hat den API-Key akzeptiert."
msgstr "Backup route reachable. Resend has accepted the API key."

#: inc/admin/components.php:70
msgid "Die Domain muss bei Resend verifiziert sein. Das Postfach muss nicht existieren, zum Beispiel noreply@ihre-domain.ch."
msgstr "The domain must be verified with Resend. The mailbox does not have to exist, for example noreply@your-domain.ch."

#: inc/admin/components.php:77
msgid "Eigener Mailserver"
msgstr "Own mail server"

#: inc/admin/components.php:81
msgid "Für den Mailserver Ihres Hosters, z. B. Infomaniak, Hostpoint, cyon."
msgstr "For the mail server of your host, e.g. Infomaniak, Hostpoint or cyon."

#: inc/admin/components.php:82
msgid "Server, Benutzer und Passwort"
msgstr "Server, user name and password"

#: inc/admin/components.php:82
msgid "Funktioniert mit fast jedem Anbieter"
msgstr "Works with almost any provider"

#: inc/admin/components.php:85
msgid "Die Anmeldung am Server war erfolgreich."
msgstr "Signing in to the server was successful."

#: inc/admin/components.php:86
msgid "Ersatzweg erreichbar. Die Anmeldung am Server war erfolgreich."
msgstr "Backup route reachable. Signing in to the server was successful."

#: inc/admin/components.php:211
msgid "Wartet auf Versand"
msgstr "Waiting to send"

#: inc/admin/components.php:211
msgid "Die Mail liegt in der Warteschlange und wird gleich gesendet."
msgstr "The email is in the queue and will be sent shortly."

#: inc/admin/components.php:212
msgid "Wird gesendet"
msgstr "Sending"

#: inc/admin/components.php:212
msgid "Die Mail wird gerade an den Anbieter übergeben."
msgstr "The email is being handed over to the provider."

#: inc/admin/components.php:213
#: inc/admin/log-view.php:18
msgid "Vom Anbieter angenommen"
msgstr "Accepted by provider"

#: inc/admin/components.php:213
msgid "Der Anbieter hat die Mail übernommen. Ob sie im Postfach ankam, bestätigt er erst mit einem Zustellbeleg."
msgstr "The provider has taken over the email. Whether it reached the mailbox is only confirmed by a delivery receipt."

#: inc/admin/components.php:214
#: inc/admin/log-view.php:19
#: inc/admin/log-view.php:197
msgid "Zustellung bestätigt"
msgstr "Delivery confirmed"

#: inc/admin/components.php:214
msgid "Der Anbieter hat die Zustellung ins Postfach des Empfängers bestätigt."
msgstr "The provider has confirmed delivery to the recipient's mailbox."

#: inc/admin/components.php:215
msgid "Wird erneut versucht"
msgstr "Retrying"

#: inc/admin/components.php:215
msgid "Der letzte Versuch hat nicht geklappt. Das Plugin versucht es automatisch noch einmal."
msgstr "The last attempt failed. The plugin will try again automatically."

#: inc/admin/components.php:216
#: inc/admin/overview.php:317
#: inc/admin/queue-view.php:53
msgid "Endgültig fehlgeschlagen"
msgstr "Permanently failed"

#: inc/admin/components.php:216
msgid "Die Mail wurde nicht gesendet und wird nicht mehr automatisch versucht."
msgstr "The email was not sent and will no longer be retried automatically."

#: inc/admin/components.php:217
#: inc/health.php:339
msgid "Versandstatus unklar"
msgstr "Sending status unclear"

#: inc/admin/components.php:217
msgid "Der Anbieter hat möglicherweise angenommen. Das Plugin sendet nicht von selbst erneut, damit nichts doppelt ankommt."
msgstr "The provider may have accepted it. The plugin will not send it again automatically, so nothing arrives twice."

#: inc/admin/components.php:218
msgid "Teilweise angenommen"
msgstr "Partially accepted"

#: inc/admin/components.php:218
msgid "Einzelne Empfänger wurden abgelehnt, die übrigen wurden angenommen."
msgstr "Some recipients were rejected; the others were accepted."

#: inc/admin/components.php:219
msgid "Nicht gesendet (Staging-Schutz)"
msgstr "Not sent (staging protection)"

#: inc/admin/components.php:219
msgid "Der Staging-Schutz hat den Versand dieser Mail verhindert."
msgstr "Staging protection prevented this email from being sent."

#: inc/admin/components.php:220
#: inc/admin/log-view.php:199
msgid "Zurückgewiesen"
msgstr "Rejected"

#: inc/admin/components.php:220
msgid "Der Mailserver des Empfängers hat die Mail zurückgewiesen."
msgstr "The recipient's mail server rejected the email."

#: inc/admin/components.php:221
#: inc/admin/log-view.php:200
msgid "Als Spam gemeldet"
msgstr "Reported as spam"

#: inc/admin/components.php:221
msgid "Der Empfänger hat die Mail als unerwünscht gemeldet."
msgstr "The recipient reported the email as unwanted."

#: inc/admin/components.php:223
msgid "Status unbekannt"
msgstr "Status unknown"

